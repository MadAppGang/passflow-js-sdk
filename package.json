{
  "name": "@passflow/core",
  "description": "Passflow JS SDK",
  "version": "0.19.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/lib/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm vite",
    "watch": "vite build --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build:dts": "tsc --build tsconfig.build.json",
    "build": "pnpm clean && pnpm vite build && pnpm build:dts",
    "test": "vitest run --reporter=default",
    "test:services": "vitest run tests/services",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "corpus:check": "node scripts/check-corpus.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check . --apply",
    "format": "biome format . --write",
    "lint:format:fix": "biome check . --apply && biome format . --write",
    "ci": "biome ci ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.2.2",
    "axios": "^1.13.2",
    "uuid": "^11.1.0"
  },
  "authors": [
    {
      "name": "Ivan Holiak",
      "url": "https://github.com/IvanHoliak"
    },
    {
      "name": "Nikita Kysil",
      "url": "https://github.com/mag-nikita-ks"
    },
    {
      "name": "Jack Rudenko",
      "email": "i@madappgang.com"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MadAppGang/passflow-js-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MadAppGang/passflow-js-sdk.git"
  },
  "packageManager": "pnpm@10.8.0"
}
